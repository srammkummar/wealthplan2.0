# Never commit real values. Copy this file to .env and fill it locally.
OPENAI_API_KEY=
WEALTHPLAN_OPENAI_MODEL=gpt-5-mini

# Optional SEC RAG configuration
PINECONE_API_KEY=
WEALTHPLAN_PINECONE_INDEX_NAME=
WEALTHPLAN_PINECONE_NAMESPACE=sec-filings
COHERE_API_KEY=
WEALTHPLAN_COHERE_RERANK_MODEL=rerank-v3.5

# Required only for SEC downloads. Use a real name/company and contact email.
WEALTHPLAN_SEC_USER_AGENT=Your Name your.email@example.com
WEALTHPLAN_SEC_REQUEST_INTERVAL_SECONDS=0.2
WEALTHPLAN_INGESTION_MANIFEST_PATH=.data/ingestion_manifest.json

# Reliability controls: two attempts means one retry.
WEALTHPLAN_EXTERNAL_RETRY_ATTEMPTS=2
WEALTHPLAN_SEC_CACHE_TTL_SECONDS=3600
WEALTHPLAN_RETRIEVAL_CACHE_TTL_SECONDS=900

# Optional durable LangGraph checkpointing
WEALTHPLAN_POSTGRES_DSN=
