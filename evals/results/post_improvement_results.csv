25-000079"", ""annual"": {""capital_expenditures_millions"": 12715.0, ""diluted_eps"": 7.46, ""fiscal_year"": 2025, ""free_cash_flow_millions"": 98767.0, ""operating_cash_flow_millions"": 111482.0, ""revenue_millions"": 416161.0, ""share_repurchases_millions"": 90711.0}, ""as_of"": ""2025-09-27"", ""cache_status"": ""fresh_cache"", ""cik"": ""0000320193"", ""company"": ""Apple Inc."", ""notes"": [""Values come from the latest matching annual SEC facts and may be unavailable when an issuer uses different taxonomy concepts."", ""Free cash flow is calculated as operating cash flow minus payments to acquire property, plant, and equipment when both facts are available."", ""Current price and valuation multiples are unavailable because SEC company facts are historical filing data, not a live market-data feed."", ""US-GAAP concepts used: RevenueFromContractWithCustomerExcludingAssessedTax, EarningsPerShareDiluted, NetCashProvidedByUsedInOperatingActivities, PaymentsToAcquirePropertyPlantAndEquipment, PaymentsForRepurchaseOfCommonStock.""], ""retrieved_at"": ""2026-09-06T05:17:37.808018+00:00"", ""snapshot_label"": ""Historical SEC company facts; not live market data."", ""source_url"": ""https://data.sec.gov/api/xbrl/companyfacts/CIK0000320193.json"", ""ticker"": ""AAPL"", ""valuation_available"": false}, ""evidence_type"": ""sec_company_facts"", ""specialist"": ""market_research""}]",1.0,1.0,1.0,1.0,,,,,True,passed,,,,,26157.594,,,1.0,1.0,,,,,,{},01a07528-9283-71d1-b1b8-1c68a8370a08,"{""citation_accuracy"": ""llm_judge:gpt-5-mini:week4_measurement_judge_v2"", ""citation_presence"": ""deterministic_structured_citation_v2"", ""context_precision"": ""keyword_context_proxy_v1"", ""faithfulness"": ""llm_judge:gpt-5-mini:week4_measurement_judge_v2"", ""hit_at_5"": ""keyword_context_proxy_v1"", ""mrr"": ""keyword_context_proxy_v1""}","{""citation_accuracy"": ""The citations SEC-1 through SEC-5 correspond to the supplied 10‑K passages that substantiate the agent’s statements. Eac